---
import { tocItems, type TocHeading } from "../lib/pure.ts";
import { t } from "../lib/i18n.ts";

interface Props {
  headings: readonly TocHeading[];
}

const items = tocItems(Astro.props.headings);
---

{items.length > 1 && (
  <nav class="toc" aria-labelledby="toc-title">
    <h2 id="toc-title" class="widget-title">
      {t.toc}
    </h2>
    <ol>
      {items.map((h) => (
        <li class={`depth-${h.depth}`}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
