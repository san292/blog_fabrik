---
import { Image } from "astro:assets";
import type { Post } from "../lib/posts.ts";
import PostMeta from "./PostMeta.astro";

interface Props {
  post: Post;
  /** Charger l'image en priorité (première carte visible sans scroll). */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
---

<article class="card">
  <Image
    class="thumb"
    src={post.entry.data.cover}
    alt=""
    widths={[400, 640, 960]}
    sizes="(max-width: 560px) 100vw, (max-width: 960px) 50vw, 380px"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
  <div class="card-body">
    <PostMeta post={post} />
    <h3>
      <a class="card-link" href={post.url}>
        {post.title}
      </a>
    </h3>
    <p>{post.description}</p>
  </div>
</article>
