---
import { collectionPageLd } from "@blog-factory/seo-kit";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedPost from "./FeaturedPost.astro";
import PostList from "./PostList.astro";
import Pagination from "./Pagination.astro";
import { homeListing } from "../lib/listing.ts";
import { pagePath } from "../lib/pure.ts";
import { config, seoSite } from "../lib/site.ts";
import { t } from "../lib/i18n.ts";

interface Props {
  page: number;
}

const { page } = Astro.props;
const { posts, pagination, featured } = await homeListing(page);
const isFirst = page === 1;
const path = pagePath("/", page, config.routes.page);
const title = isFirst ? config.name : `${t.latest} – ${t.page} ${page}`;
const description = isFirst
  ? config.description
  : `${config.description.slice(0, 120)} (${t.page.toLowerCase()} ${page})`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  prevPath={pagination.prevPath}
  nextPath={pagination.nextPath}
  jsonLd={[
    collectionPageLd({
      site: seoSite,
      path,
      name: isFirst ? config.name : title,
      description,
      type: "Blog",
    }),
  ]}
>
  {isFirst ? (
    <header class="home-head">
      <h1>{config.tagline}</h1>
    </header>
  ) : (
    <header class="page-head">
      <h1>
        {t.latest} – {t.page} {page}
      </h1>
    </header>
  )}
  {isFirst && featured && <FeaturedPost post={featured} />}
  {isFirst && (
    <div class="page-head">
      <h2>{t.latest}</h2>
    </div>
  )}
  <PostList posts={posts} eagerCount={isFirst && !featured ? 2 : 0} />
  <Pagination info={pagination} />
</BaseLayout>

<style>
  .home-head {
    margin-bottom: 28px;
  }
  .home-head h1 {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.01em;
    max-width: 30ch;
    color: var(--muted);
  }
</style>
