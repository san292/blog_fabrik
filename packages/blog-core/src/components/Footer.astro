---
import { getPages } from "../lib/posts.ts";
import { config, urls } from "../lib/site.ts";
import { t } from "../lib/i18n.ts";

const pages = (await getPages()).filter((p) => p.data.footer);
const links = [
  ...config.footerLinks,
  ...pages.map((p) => ({ label: p.data.title, href: urls.post(p.id) })),
  { label: "RSS", href: urls.rss() },
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap ftr">
    <span>
      © {year} {config.publisher.name}. {t.rights}
    </span>
    <nav aria-label={t.footerNav}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
