---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 44 } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<span
  class="avatar"
  aria-hidden="true"
  style={`width:${size}px;height:${size}px;font-size:${Math.round(size / 2.8)}px`}
>
  {initials}
</span>
